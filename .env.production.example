# Copy to .env.production and replace every CHANGE_ME value before deployment.
POSTGRES_USER=clinic
POSTGRES_DB=clinic
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_HOURS=8
WEB_CONCURRENCY=1
LOGIN_RATE_LIMIT=8

# Use two DNS names. Both must point to the public server IP before starting Caddy.
APP_DOMAIN=clinic.CHANGE_ME.example.com
API_DOMAIN=api-clinic.CHANGE_ME.example.com
CORS_ORIGINS=https://clinic.CHANGE_ME.example.com

# Stable named database volume. Do not change after first production deployment.
DB_VOLUME_NAME=clinic_frontdesk_pgdata
